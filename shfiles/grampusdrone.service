[Unit]
Description=GrampusDrone onboard ROS stack
After=network-online.target systemd-timesyncd.service
Wants=network-online.target systemd-timesyncd.service

[Service]
Type=simple
User=orin
WorkingDirectory=/home/orin/GrampusDrone
Environment=FCU_DEVICE=/dev/ttyACM0
Environment=FCU_BAUD=57600
Environment=START_CONTROLLER=false
Environment=START_PLANNER=false
Environment=NETWORK_CHECK_HOST=connectivity-check.ubuntu.com
Environment=NETWORK_CHECK_PORT=80
Environment=NETWORK_CHECK_TIMEOUT=5
Environment=CLOCK_START_STEP_TOLERANCE=0.01
Environment=MIN_VALID_EPOCH=1735689600
Environment=CLOCK_STABLE_SECONDS=10
Environment=CLOCK_STEP_TOLERANCE=0.5
Environment=CLOCK_WAIT_TIMEOUT=0
ExecStart=/home/orin/GrampusDrone/shfiles/start_onboard.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
